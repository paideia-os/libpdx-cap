        // ---- Stage 38: cap_unpack_checked_into REJECT — reset+parse
        //                ok2 (KIND_TTY only) into declctx_b; pack a
        //                KIND_USER cap; call cap_unpack_checked_into.
        //                Expect CAP_MANIFEST_EXTRA and capctx_a is
        //                LEFT UNTOUCHED (still holds S37's values —
        //                fail-fast contract mirrored from
        //                cap_unpack_checked).
        mov rax, 38;
        lea r11, [rip + _m4mx_stage];
        mov [r11], rax;

        // Re-populate declctx_b with just KIND_TTY.
        lea rdi, [rip + _m4mx_declctx_b];
        call caps_decl_ctx_reset;

        lea rdi, [rip + _m4mx_declctx_b];
        lea rsi, [rip + _m4mx_decl_ok2];
        mov rdx, 21;
        call caps_decl_parse_into;
        cmp rax, 0;
        jne _m4mx_fail;

        // Pack KIND_USER (not in declctx_b) into cap_buf[0..16].
        lea rdi, [rip + _m4mx_cap_buf];
        mov rsi, 4;
        mov rdx, 0x190;                   // KIND_USER
        mov rcx, 1;
        xor r8, r8;
        call cap_pack;
        cmp rax, 0;
        jne _m4mx_fail;

        // cap_unpack_checked_into against declctx_b — must reject.
        lea rdi, [rip + _m4mx_capctx_a];
        lea rsi, [rip + _m4mx_cap_buf];
        lea rdx, [rip + _m4mx_declctx_b];
        call cap_unpack_checked_into;
        mov r11, 0xFFFFFFFB;              // CAP_MANIFEST_EXTRA
        cmp rax, r11;
        jne _m4mx_fail;

        // capctx_a.kind STILL 0x197 (S37 value) — reject path left the
        // ctx untouched.
        lea r11, [rip + _m4mx_capctx_a];
        mov rax, [r11 + 8];
        cmp rax, 0x197;
        jne _m4mx_fail;

        // capctx_a.slot STILL 2 (S37 value).
        lea r11, [rip + _m4mx_capctx_a];
        mov rax, [r11 + 0];
        cmp rax, 2;
        jne _m4mx_fail;

        // ---- Stage 39: cap_manifest_verify_into MISSING — declctx_a
        //                requires KIND_TTY + KIND_USER but received[]
        //                holds only one KIND_TTY cap. Expect
        //                CAP_MANIFEST_MISSING.
        mov rax, 39;
        lea r11, [rip + _m4mx_stage];
        mov [r11], rax;

        // Pack cap_buf[0..16] = KIND_TTY (already done in S37 but
        // repack for clarity).
        lea rdi, [rip + _m4mx_cap_buf];
        xor rsi, rsi;
        mov rdx, 0x197;
        mov rcx, 1;
        xor r8, r8;
        call cap_pack;
        cmp rax, 0;
        jne _m4mx_fail;

        // Verify: KIND_USER missing.
        lea rdi, [rip + _m4mx_declctx_a];
        lea rsi, [rip + _m4mx_cap_buf];
        mov rdx, 1;                       // received_count = 1
        call cap_manifest_verify_into;
        mov r11, 0xFFFFFFFC;              // CAP_MANIFEST_MISSING
        cmp rax, r11;
        jne _m4mx_fail;

        // ---- Stage 40: ENH-008 cross-verify fingerprint — SAME
        //                received wire (one KIND_TTY cap), TWO decl
        //                ctxs, different results:
        //                  * declctx_a (requires TTY + USER)  → MISSING
        //                  * declctx_b (requires TTY only)    → OK
        //                Neither call disturbs the other decl ctx —
        //                cap_manifest_verify_into holds no cross-call
        //                state in the decl ctx that would leak.
        mov rax, 40;
        lea r11, [rip + _m4mx_stage];
        mov [r11], rax;

        // First: against declctx_a → MISSING (KIND_USER not received).
        lea rdi, [rip + _m4mx_declctx_a];
        lea rsi, [rip + _m4mx_cap_buf];
        mov rdx, 1;
        call cap_manifest_verify_into;
        mov r11, 0xFFFFFFFC;              // CAP_MANIFEST_MISSING
        cmp rax, r11;
        jne _m4mx_fail;

        // Second: against declctx_b → OK (only KIND_TTY required,
        // exactly matched).
        lea rdi, [rip + _m4mx_declctx_b];
        lea rsi, [rip + _m4mx_cap_buf];
        mov rdx, 1;
        call cap_manifest_verify_into;
        cmp rax, 0;
        jne _m4mx_fail;

        // Confirm both decl ctxs still hold their expected req_count
        // after the two verify calls (fingerprint: verify_into is a
        // pure reader — never mutates the decl ctx).
        lea r11, [rip + _m4mx_declctx_a];
        mov rax, [r11 + 256];
        cmp rax, 2;
        jne _m4mx_fail;

        lea r11, [rip + _m4mx_declctx_b];
        mov rax, [r11 + 256];
        cmp rax, 1;
        jne _m4mx_fail;

        // ====================================================================
        // All stages passed.
        // ====================================================================
        xor rax, rax;
        lea r11, [rip + _m4mx_stage];
        mov [r11], rax;
        pop rbx;
        ret;

      _m4mx_fail:
        // Load the current stage index (last-written by the failing
        // stage's `mov rax, N; mov [_m4mx_stage], rax` prologue) and
        // return it in rax. _m4mx_stage remains at that value for a
        // caller inspecting the .bss slot post-return.
        lea r11, [rip + _m4mx_stage];
        mov rax, [r11];
        pop rbx;
        ret
      }
    }
}
