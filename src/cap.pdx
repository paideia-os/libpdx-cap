// src/cap.pdx — libpdx-cap.M1-001
// Cap module: wire format + pack/unpack + manifest_verify skeleton.
//
// Design context
// --------------
// M1 of the R49 shared-library wave: the userspace-side idiom for
// serializing a capability across a process boundary (shell → tool via
// sys_cap_transfer) and for verifying at exec that the received cap set
// matches the callee's caps.decl. This module ships the format + the
// pack/unpack helpers + the manifest_verify entry point; M2 fills the
// manifest_verify body (OK | MISSING | EXTRA), M3 adds KIND_USER_ref
// decode + signed-inode helpers.
//
// The wire record shape matches the InitCap sidecar record (paideia-os
// src/kernel/core/loader/init_caps.pdx, R20b.M4-001) so a cap received
// from the loader and a cap received via sys_cap_transfer share one
// on-wire layout. Baseline: pack + unpack round-trip preserves slot +
// kind + rights + target_ptr.
//
// Record layout (16 bytes per Cap, natural 8-byte alignment):
//
//   +0    u16 slot            (target slot in the task's cap_table; 0..255)
//   +2    u16 kind            (KIND_* value — matches cap/kind.pdx in paideia-os)
//   +4    u32 rights          (RIGHTS_* mask)
//   +8    u64 target_ptr      (kind-specific; e.g. endpoint tail per kind_endpoint.pdx)
//
// M1 packs qword0 = slot | (kind << 16) | (rights << 32) with a single
// store, and qword1 = target_ptr with a second store; unpack mirrors
// with two loads + shifts + masks. This is the same two-quad idiom the
// InitCap validator uses when reading a sidecar entry — no narrow-store
// mnemonic is needed and the wire buffer never observes a torn write
// between fields inside a single Cap.
//
// paideia-as compliance
// ---------------------
// Every function follows the constraints in
// design/kernel/paideia-as-conformance.md (paideia-os):
//   - Module name PascalCase basename (`Cap`), no directory prefix.
//   - No `test` mnemonic; every zero-check uses `cmp reg, 0`.
//   - Every `cmp reg, imm` uses an immediate ≤ 0x7FFFFFFF (or fits in
//     the small-imm sign-extend window); large immediates go via r11.
//   - `r11` is scratch and is never assumed live across a call.
//   - Byte loads use `xor rax, rax; mov_b rax, [ptr]` (per #1248
//     mitigation) — cap_unpack uses qword loads only, so this pattern
//     shows up in caps_decl.pdx (the text parser) rather than here.
//   - Both entry points are LEAF functions in M1 — no callee-save
//     touched, no push/pop parity to preserve.

module Cap = structure {

  // ============================================================================
  // Format constants
  // ============================================================================

  // Size of one Cap record on the wire (16 bytes). Same as InitCap
  // sidecar's INIT_CAP_ENTRY_SIZE — deliberate: a cap received from
  // sys_cap_transfer and a cap seeded by the loader share one layout.
  pub let CAP_ENTRY_SIZE : u64 = 16

  // Alignment of a Cap record on the wire (8 bytes). Matches the
  // sidecar's natural alignment so an array of Caps can be walked with
  // qword loads at [base + i*16 + 0] and [base + i*16 + 8].
  pub let CAP_ALIGN : u64 = 8

  // Maximum accepted slot value (exclusive). Mirrors INIT_CAP_SLOT_MAX
  // in paideia-os init_caps.pdx — the cap_table holds 256 slots per
  // task (cap/table.pdx). A slot >= this bound cannot address a valid
  // descriptor and cap_pack rejects it before touching the wire buffer.
  pub let CAP_SLOT_MAX : u64 = 256

  // ============================================================================
  // Return codes
  // ============================================================================

  // Success. Every entry point returns this on the happy path.
  pub let CAP_OK               : u64 = 0

  // Slot out of range (>= CAP_SLOT_MAX). cap_pack refuses to write a
  // wire record naming a nonexistent cap_table slot; the loader-side
  // InitCap validator has the mirror check on the receive side.
  pub let CAP_BAD_SLOT         : u64 = 0xFFFFFFFE

  // Reserved for M2's kind check (kind not in the KIND_TRANSFERABLE
  // set). M1's cap_pack does not enforce this — a caller can pack any
  // u16 kind. M2 wires this up alongside cap_manifest_verify's full
  // logic, at which point cap_pack picks up the same rejection.
  pub let CAP_BAD_KIND         : u64 = 0xFFFFFFFD

  // cap_manifest_verify: the received cap set is MISSING a cap the
  // callee's caps.decl requires. Populated by M2-001; M1's skeleton
  // never returns this.
  pub let CAP_MANIFEST_MISSING : u64 = 0xFFFFFFFC

  // cap_manifest_verify: the received cap set contains an EXTRA cap
  // the callee's caps.decl does not name. Populated by M2-001; M1's
  // skeleton never returns this.
  pub let CAP_MANIFEST_EXTRA   : u64 = 0xFFFFFFFB

  // cap_pack_narrowed: the caller asked to write a narrowed cap whose
  // requested rights are not a subset of the currently-held rights —
  // i.e., a bit is set in `narrowed_rights` that is NOT set in
  // `original_rights`. That is widening the cap, which the send site
  // must refuse. Landed at M2-002.
  //
  // Codes 0xFFFFFFFA..0xFFFFFFF6 are reserved for the CapsDecl module
  // (see design/architecture.md §5). Cap-module error codes extend
  // downward from 0xFFFFFFF5.
  pub let CAP_RIGHTS_WIDENING  : u64 = 0xFFFFFFF5

  // cap_manifest_verify: the caps.decl names a KIND that is not in the
  // KindNames mirror (see kind_names.pdx). Same numeric value as
  // KindNames::KIND_NAMES_UNKNOWN — the two constants live in two
  // modules because KindNames is a leaf Cap depends on and cannot
  // depend back, but they name the same failure mode. Landed at M2-001.
  pub let CAP_KIND_UNKNOWN     : u64 = 0xFFFFFFF4

  // ============================================================================
  // Singleton unpack destination (M1 shape)
  // ============================================================================
  //
  // cap_unpack populates these four slots — the caller reads the fields
  // it needs directly. This mirrors ParsedArgs' singleton .bss pattern
  // in libpdx-argv (src/parsed_args.pdx): one unpack per call site is
  // enough for M1's consumers (the shell + every tool's exec-time
  // manifest check), and M4 introduces a caller-owned Cap* variant
  // once multi-cap unpacking becomes real. Consumers depend on the
  // field NAMES, not on the storage class.
  pub let mut unpacked_slot       : u64 = uninit @align(8)
  pub let mut unpacked_kind       : u64 = uninit @align(8)
  pub let mut unpacked_rights     : u64 = uninit @align(8)
  pub let mut unpacked_target_ptr : u64 = uninit @align(8)

  // ============================================================================
  // cap_reset()
  //
  // Signature: cap_reset : () -> () !{mem} @{}
  //
  // Clear the four unpack slots so a subsequent cap_unpack starts from a
  // known-zero baseline. The M1 pack+unpack round-trip test in tests/
  // (added at M4-001) begins with a cap_reset so a botched cap_unpack
  // that leaves an old value in place is caught rather than masked.
  //
  // Leaf function; r11 scratch; no push/pop parity to preserve.
  // ============================================================================
  pub let cap_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-cap.M1-001: zero the four unpacked_* slots so cap_unpack starts from a known-empty Cap. xor rax,rax produces the zero constant; four lea+mov pairs write it to each slot. r11 is scratch (paideia-as conformance). Leaf function; no callee-save touched.",
      block: {
        xor rax, rax;
        lea r11, [rip + unpacked_slot];       mov [r11], rax;
        lea r11, [rip + unpacked_kind];       mov [r11], rax;
        lea r11, [rip + unpacked_rights];     mov [r11], rax;
        lea r11, [rip + unpacked_target_ptr]; mov [r11], rax;
        ret
      }
    }

  // ============================================================================
  // cap_pack(dst, slot, kind, rights, target_ptr) -> rc
  //
  // Signature: cap_pack : (u64, u64, u64, u64, u64) -> u64 !{mem} @{}
  // RDI (input): dst        — VA of a 16-byte destination buffer (8-byte aligned)
  // RSI (input): slot       — 0..CAP_SLOT_MAX-1; else CAP_BAD_SLOT
  // RDX (input): kind       — KIND_* (u16; caller must have masked)
  // RCX (input): rights     — RIGHTS_* mask (u32; high bits discarded by shift)
  // R8  (input): target_ptr — kind-specific u64
  // RAX (output): CAP_OK on success, else CAP_BAD_SLOT
  //
  // Writes exactly 16 bytes to dst as two qwords:
  //   [dst+0] = (slot & 0xFFFF) | ((kind & 0xFFFF) << 16) | (rights << 32)
  //   [dst+8] = target_ptr
  //
  // Fail-fast on the slot bound; dst is NOT touched on the reject path,
  // so a caller that recycles a buffer sees its old contents preserved
  // when pack refuses — same discipline as init_caps_validate returning
  // BAD_COUNT before touching any downstream state.
  //
  // Register plan (leaf, all caller-save):
  //   rax = qword0 accumulator / return value
  //   r10 = mask constant (0xFFFF for slot / kind lanes)
  //   r11 = shifted-field scratch (kind and rights lanes)
  //   rdi, rsi, rdx, rcx, r8 = untouched inputs
  // ============================================================================
  pub let cap_pack : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (dst: u64) (slot: u64) (kind: u64) (rights: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-cap.M1-001 cap_pack. Two-qword store: qword0 fuses slot|kind|rights (16+16+32 bits) with a single OR-chain, qword1 is target_ptr. Slot bound: cmp rsi,CAP_SLOT_MAX; jae cap_pack_bad_slot before any write to dst so a rejected pack leaves the caller's buffer untouched. jae (unsigned) is deliberate — slot is a u64 and jge (signed) would fail open for slot >= 2^63 (libpdx-cap#13). r10 holds the 0xFFFF mask for the slot / kind lanes (both fit in cmp reg,imm ≤ 0x7FFFFFFF); rights lane needs no mask because the shl 32 discards the top 32 bits into the void. r11 is the shifted-field scratch, paideia-as-reserved. Leaf function — no push/pop parity to preserve. Return code CAP_OK (0) or CAP_BAD_SLOT (0xFFFFFFFE); the latter follows InitCap's INIT_CAPS_BAD_SLOT precedent (paideia-os init_caps.pdx) so the two validators return a shared vocabulary.",
      block: {
        // Step 1: slot bound. cmp rsi, 256. Fail-fast before any store.
        // Unsigned compare (jae, not jge) — slot is u64; a signed jge
        // reads slot >= 2^63 as negative and fails open (libpdx-cap#13).
        cmp rsi, 256;                       // CAP_SLOT_MAX = 256
        jae cap_pack_bad_slot;

        // Step 2: assemble qword0 = slot | (kind << 16) | (rights << 32).
        mov r10, 0xFFFF;                    // slot / kind lane mask

        mov rax, rsi;
        and rax, r10;                       // rax = slot & 0xFFFF (bits 0..15)

        mov r11, rdx;
        and r11, r10;                       // r11 = kind & 0xFFFF
        shl r11, 16;                        // r11 = (kind & 0xFFFF) << 16
        or  rax, r11;                       // rax |= kind lane

        mov r11, rcx;
        shl r11, 32;                        // r11 = rights << 32 (top 32 bits discarded)
        or  rax, r11;                       // rax |= rights lane

        // Step 3: store both qwords.
        mov [rdi + 0], rax;                 // wire[0..7]
        mov [rdi + 8], r8;                  // wire[8..15] = target_ptr

        xor rax, rax;                       // CAP_OK
        ret;

      cap_pack_bad_slot:
        mov rax, 0xFFFFFFFE;                // CAP_BAD_SLOT
        ret
      }
    }

  // ============================================================================
  // cap_pack_narrowed(dst, slot, kind, original_rights, narrowed_rights,
  //                   target_ptr) -> rc
  //
  // Signature: cap_pack_narrowed : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{}
  // RDI (input): dst              — VA of a 16-byte destination buffer (8-aligned)
  // RSI (input): slot             — 0..CAP_SLOT_MAX-1; else CAP_BAD_SLOT
  // RDX (input): kind             — KIND_* (u16; caller must have masked)
  // RCX (input): original_rights  — rights the caller currently holds
  // R8  (input): narrowed_rights  — rights the caller wants to write
  // R9  (input): target_ptr       — kind-specific u64
  // RAX (output): CAP_OK | CAP_BAD_SLOT | CAP_RIGHTS_WIDENING
  //
  // M2-002 — cap-narrowing send helper. `shell` (and every tool that
  // forwards a cap to a child) uses this to pack a Cap whose rights are
  // a strict SUBSET of the rights currently held. Any bit set in
  // narrowed_rights that is NOT set in original_rights would widen the
  // cap on the wire — refused with CAP_RIGHTS_WIDENING before touching
  // the destination buffer.
  //
  // The widen check is `(narrowed & ~original) == 0`. When that mask
  // is non-zero, the caller is trying to hand a child cap authority the
  // caller does not itself possess — the invariant this milestone
  // enforces. Slot bound reuses cap_pack's precedent; the two-qword
  // store idiom is identical to cap_pack's after the check.
  //
  // Widening precedes the slot check on purpose: a broken narrowing
  // policy is a bug in the caller's cap-forwarding logic and must
  // surface even if the same call also passed a bad slot. (Both are
  // fatal, but the widening return names the more consequential fault.)
  //
  // Register plan (leaf, all caller-save):
  //   rax = widen-mask scratch / qword0 accumulator / return value
  //   r10 = mask constant (0xFFFF for slot / kind lanes) OR widen mask
  //   r11 = shifted-field scratch / large-imm mov target for CAP_BAD_SLOT
  // ============================================================================
  pub let cap_pack_narrowed : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (dst: u64) (slot: u64) (kind: u64) (original_rights: u64) (narrowed_rights: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-cap.M2-002 cap_pack_narrowed. Cap-forwarding helper: writes a narrowed Cap only after proving the requested rights are a strict subset of the currently-held rights. The widen check `(narrowed & ~original) == 0` is computed as `mov rax, rcx; not rax; and rax, r8` — if the result is non-zero, at least one bit was set in narrowed_rights that was clear in original_rights (widening), refused with CAP_RIGHTS_WIDENING before any store to dst. Slot bound (cmp rsi, 256) reuses cap_pack's precedent and is checked AFTER the widen check so a widening attempt surfaces even on an otherwise-bad slot. Two-qword store body (qword0 = slot|kind|rights, qword1 = target_ptr) is identical to cap_pack — same register plan, same paideia-as compliance (r11 scratch, no cmp imm > 0x7FFFFFFF, no `test`). Leaf function; no push/pop parity to preserve.",
      block: {
        // Step 1: widen check. rax = narrowed & ~original.
        mov rax, rcx;                   // rax = original
        not rax;                        // rax = ~original
        and rax, r8;                    // rax = narrowed & ~original
        cmp rax, 0;
        jne _cpn_widening;

        // Step 2: slot bound. Unsigned compare (jae, not jge) — see
        // cap_pack's identical fix (libpdx-cap#13).
        cmp rsi, 256;                   // CAP_SLOT_MAX
        jae _cpn_bad_slot;

        // Step 3: assemble qword0 = slot | (kind << 16) | (narrowed << 32).
        mov r10, 0xFFFF;                // slot / kind lane mask

        mov rax, rsi;
        and rax, r10;                   // rax = slot & 0xFFFF

        mov r11, rdx;
        and r11, r10;                   // r11 = kind & 0xFFFF
        shl r11, 16;
        or  rax, r11;                   // rax |= kind lane

        mov r11, r8;                    // narrowed rights (already validated)
        shl r11, 32;
        or  rax, r11;                   // rax |= rights lane

        // Step 4: store both qwords.
        mov [rdi + 0], rax;
        mov [rdi + 8], r9;              // target_ptr

        xor rax, rax;                   // CAP_OK
        ret;

      _cpn_widening:
        mov rax, 0xFFFFFFF5;            // CAP_RIGHTS_WIDENING
        ret;

      _cpn_bad_slot:
        mov rax, 0xFFFFFFFE;            // CAP_BAD_SLOT
        ret
      }
    }

  // ============================================================================
  // cap_unpack(src) -> rc
  //
  // Signature: cap_unpack : (u64) -> u64 !{mem} @{}
  // RDI (input): src — VA of a 16-byte source buffer (8-byte aligned)
  // RAX (output): CAP_OK (M1 never fails; kind-set validation lands in M2)
  //
  // Loads the two qwords and splits qword0 into the three lanes:
  //   unpacked_slot       = qword0 & 0xFFFF
  //   unpacked_kind       = (qword0 >> 16) & 0xFFFF
  //   unpacked_rights     = qword0 >> 32
  //   unpacked_target_ptr = qword1
  //
  // The rights lane needs no mask because `shr rax, 32` naturally zero-
  // extends the result into the low half — no bits above bit 31 can
  // survive the shift.
  //
  // M1 has no receive-side kind check; M2-003 adds "extra cap → reject"
  // at which point cap_unpack picks up a CAP_BAD_KIND return path and
  // stops writing the unpack slots if the kind is not in the callee's
  // caps.decl.
  //
  // Register plan (leaf):
  //   rax = qword0 accumulator
  //   r9  = extracted lane value (slot, kind, rights)
  //   r10 = mask constant (0xFFFF)
  //   r11 = lea address scratch
  //   rdi = untouched input
  // ============================================================================
  pub let cap_unpack : (u64) -> u64 !{mem} @{} =
    fn (src: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-cap.M1-001 cap_unpack. Two qword loads: qword0 from [rdi+0] carries the three narrow lanes (slot / kind / rights), qword1 from [rdi+8] carries target_ptr verbatim. Slot lane = qword0 & 0xFFFF; kind lane = (qword0 >> 16) & 0xFFFF; rights lane = qword0 >> 32 (shr zero-extends, no mask needed). Populates the four Cap singleton .bss slots for the caller to read. r11 is scratch (paideia-as conformance) and appears in every lea+mov store; r10 holds the 0xFFFF mask; r9 carries the extracted lane value across the store. Leaf function — no push/pop parity. Round-trip guarantee (baseline test at M4-001): the values written by cap_pack are recovered here byte-for-byte across all four fields.",
      block: {
        // Load qword0. Every lane derives from it via mov+shift+mask.
        mov rax, [rdi + 0];

        // Slot lane: rax & 0xFFFF.
        mov r10, 0xFFFF;
        mov r9, rax;
        and r9, r10;
        lea r11, [rip + unpacked_slot];
        mov [r11], r9;

        // Kind lane: (rax >> 16) & 0xFFFF.
        mov r9, rax;
        shr r9, 16;
        and r9, r10;
        lea r11, [rip + unpacked_kind];
        mov [r11], r9;

        // Rights lane: rax >> 32. shr naturally zero-extends → no mask.
        mov r9, rax;
        shr r9, 32;
        lea r11, [rip + unpacked_rights];
        mov [r11], r9;

        // Target_ptr lane: [rdi+8] verbatim.
        mov r9, [rdi + 8];
        lea r11, [rip + unpacked_target_ptr];
        mov [r11], r9;

        xor rax, rax;                       // CAP_OK
        ret
      }
    }

  // ============================================================================
  // cap_unpack_checked(src) -> rc
  //
  // Signature: cap_unpack_checked : (u64) -> u64 !{mem} @{}
  // RDI (input): src — VA of a 16-byte Cap record (8-byte aligned)
  // RAX (output): CAP_OK | CAP_MANIFEST_EXTRA
  //   (CAP_KIND_UNKNOWN is intentionally NOT surfaced here — see the
  //   "loud detection lives at cap_manifest_verify's Pass 1" note below.)
  //
  // M2-003 — receive-site guarded unpack. This entry unpacks a single
  // Cap and then verifies its kind lane is named by the currently-
  // parsed CapsDecl. If the received kind is not in the callee's
  // caps.decl, the unpack is REJECTED without touching the four
  // `unpacked_*` singleton slots — mirroring cap_pack's fail-fast
  // discipline (bad slot leaves dst untouched; extra cap leaves
  // unpacked_* untouched).
  //
  // The kind-lane check walks CapsDecl::req_kind_names[0..req_count],
  // resolves each name via KindNames::kind_names_resolve, and matches
  // against the extracted kind. Miss → CAP_MANIFEST_EXTRA. If the
  // decl names a kind not in the KindNames mirror, that decl entry
  // simply fails to match (loud detection is at
  // cap_manifest_verify's Pass 1 below, not here).
  //
  // Relation to cap_manifest_verify: cap_manifest_verify runs ONCE at
  // exec after every cap has landed; cap_unpack_checked runs on EACH
  // cap as the tool consumes it — catching an extra cap synchronously
  // at consume time so a tool that unpacks lazily does not have to
  // pre-scan the whole cap array. Both use the same rejection code
  // (CAP_MANIFEST_EXTRA) so a caller sees one vocabulary.
  //
  // Register plan (non-leaf; calls kind_names_resolve):
  //   r12 = decl scan index j
  //   r13 = extracted recv kind (survives nested calls)
  //   r14 = src ptr save (survives nested calls)
  //   rax = kind_names_resolve result / return code
  //   r11 = LEA scratch for .bss addresses
  //
  // rsp alignment: 3 callee-save pushes (r12/r13/r14). Entry rsp % 16 == 8;
  // after 3 pushes (-24 bytes) rsp % 16 == 0. Aligned at every nested-
  // call site. No pad needed.
  // ============================================================================
  pub let cap_unpack_checked : (u64) -> u64 !{mem} @{} =
    fn (src: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-cap.M2-003 cap_unpack_checked. Guarded receive-site unpack: extracts the kind lane from the wire record, verifies it is named by the parsed CapsDecl, and only then writes the four unpacked_* singleton slots. If the kind is not in the decl, the unpack is refused with CAP_MANIFEST_EXTRA and unpacked_* are left untouched (fail-fast; mirrors cap_pack's discipline of leaving dst untouched on bad-slot). Kind-lane extraction reuses the M1 shift-and-mask idiom from cap_unpack. Uses KindNames::kind_names_resolve to translate each decl name to an ordinal for the compare. Note: the reverse pairing — a decl name that resolves to KIND_NAMES_UNKNOWN — simply fails to match at the inner compare and does NOT surface as CAP_KIND_UNKNOWN here; that loud detection lives at cap_manifest_verify's Pass 1 (a per-consume check would fire spuriously if the tool only invokes some decl entries). paideia-as conformance: r11 is .bss LEA scratch; cmp reg,imm uses imm ≤ 0x7FFFFFFF (largest is 0xFFFF for the kind mask); no `test` mnemonic; no byte reads (all wire loads are qwords). Non-leaf: three callee-save pushes (r12/r13/r14) → rsp % 16 == 0 at every nested-call site.",
      block: {
        // ---- prologue ------------------------------------------------------
        push r12;
        push r13;
        push r14;

        mov r14, rdi;                   // r14 = src (save across nested calls)

        // Extract recv kind = (src[0..7] >> 16) & 0xFFFF.
        mov rax, [rdi + 0];
        shr rax, 16;
        and rax, 0xFFFF;
        mov r13, rax;                   // r13 = recv kind

        // Scan CapsDecl for a matching name.
        xor r12, r12;                   // j = 0

      _cuc_scan_head:
        lea r11, [rip + req_count];
        mov rax, [r11];
        cmp r12, rax;
        jge _cuc_extra;

        lea r11, [rip + req_kind_names];
        mov rdi, [r11 + r12*8];

        call kind_names_resolve;

        cmp rax, r13;
        je _cuc_hit;

        add r12, 1;
        jmp _cuc_scan_head;

      _cuc_hit:
        // Kind is declared. Perform the four-lane unpack into the
        // singleton .bss slots (same store shape as cap_unpack).
        mov rax, [r14 + 0];             // qword0

        mov r10, 0xFFFF;

        mov r9, rax;
        and r9, r10;
        lea r11, [rip + unpacked_slot];
        mov [r11], r9;

        mov r9, rax;
        shr r9, 16;
        and r9, r10;
        lea r11, [rip + unpacked_kind];
        mov [r11], r9;

        mov r9, rax;
        shr r9, 32;
        lea r11, [rip + unpacked_rights];
        mov [r11], r9;

        mov r9, [r14 + 8];
        lea r11, [rip + unpacked_target_ptr];
        mov [r11], r9;

        xor rax, rax;                   // CAP_OK
        pop r14;
        pop r13;
        pop r12;
        ret;

      _cuc_extra:
        // Kind not declared. Leave unpacked_* untouched.
        mov rax, 0xFFFFFFFB;            // CAP_MANIFEST_EXTRA
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ============================================================================
  // cap_manifest_verify(decl_ptr, received_ptr, received_count) -> rc
  //
  // Signature: cap_manifest_verify : (u64, u64, u64) -> u64 !{mem} @{}
  // RDI (input): decl_ptr       — informational; reserved for M4's
  //                               caller-owned CapsDecl* variant. M2
  //                               drives the compare from the CapsDecl
  //                               singleton (`req_count`, `req_kind_names`)
  //                               so decl_ptr is ignored in this milestone.
  //                               Callers pass 0 or a lea(CapsDecl::req_count)
  //                               and the value is not dereferenced.
  // RSI (input): received_ptr   — VA of a Cap[] wire array (each record
  //                               16 bytes, 8-byte aligned).
  // RDX (input): received_count — number of Cap records in received_ptr.
  // RAX (output): CAP_OK | CAP_MANIFEST_MISSING | CAP_MANIFEST_EXTRA
  //             | CAP_KIND_UNKNOWN
  //
  // Two-pass compare (M2-001):
  //   Pass 1 (MISSING): for each declared name in
  //     `CapsDecl::req_kind_names[0..req_count]`, resolve to an ordinal
  //     via `KindNames::kind_names_resolve`; if the ordinal is
  //     KIND_NAMES_UNKNOWN, return CAP_KIND_UNKNOWN (loud fail — a
  //     caps.decl that names a kind libpdx-cap does not know about is
  //     a configuration error the tool must surface, not silently
  //     accept). Otherwise scan received[0..received_count] for a Cap
  //     whose kind lane equals the ordinal. Miss → CAP_MANIFEST_MISSING.
  //   Pass 2 (EXTRA): for each received Cap, extract the kind lane and
  //     scan `CapsDecl::req_kind_names[0..req_count]` for a name whose
  //     resolved ordinal matches. Miss → CAP_MANIFEST_EXTRA.
  //
  // Rights-argument text parsing (the (read, subtree=/home) suffix in
  // caps.decl) is deferred to M3-001 — M2-001 compares by KIND ordinal
  // only. Rights-mask narrowing at the SEND site lands separately at
  // M2-002 (cap_pack_narrowed); receive-side extra-cap rejection lands
  // at M2-003 (cap_unpack_checked). Together the three form the M2 tier.
  //
  // Register plan (non-leaf; calls into KindNames::kind_names_resolve):
  //   r12 = pass 1 outer loop i / pass 2 outer loop i (reused between passes)
  //   r13 = pass 1 inner scan j / pass 2 inner scan j
  //   r14 = received_ptr (spilled from rsi; survives nested calls)
  //   r15 = received_count (spilled from rdx; survives nested calls)
  //   rbx = pass-2 recv kind held across the inner call
  //   rax = kind_names_resolve result / return code
  //   rcx = pass-1 target ord scratch
  //   r11 = LEA scratch for .bss addresses
  //
  // rsp alignment: 5 callee-save pushes (r12/r13/r14/r15/rbx). Entry
  // rsp % 16 == 8; after 5 pushes (-40 bytes) rsp % 16 == 0 — aligned
  // for every nested call. No pad slot needed. Matched pops at
  // epilogue preserve SysV parity.
  // ============================================================================
  pub let cap_manifest_verify : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (decl_ptr: u64) (received_ptr: u64) (received_count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-cap.M2-001 cap_manifest_verify. Two-pass compare between CapsDecl::req_kind_names[] (populated by caps_decl_parse) and the received Cap[] array. Pass 1 (MISSING): resolve each declared name to an ordinal via KindNames::kind_names_resolve, then linear-scan received[] for a matching kind lane. Pass 2 (EXTRA): for each received Cap, extract its kind lane and scan the declared names, resolving each against KindNames. Returns CAP_OK, CAP_MANIFEST_MISSING, CAP_MANIFEST_EXTRA, or CAP_KIND_UNKNOWN (if the decl names a kind libpdx-cap does not mirror). decl_ptr is INFORMATIONAL for M2 — the singleton pattern from CapsDecl means the parsed record is at a fixed location; decl_ptr is reserved for the M4 caller-owned variant and is not dereferenced here. Kind lane extraction reuses the M1 shift-and-mask idiom from cap_unpack (qword0 >> 16 & 0xFFFF). paideia-as conformance: r11 is .bss LEA scratch; every cmp reg,imm uses imm ≤ 0x7FFFFFFF (largest is 0xFFFF for the kind mask); no `test` mnemonic; byte reads N/A (all loads are qwords from the wire array). Non-leaf: five callee-save pushes (r12/r13/r14/r15/rbx) → rsp % 16 == 0 at every nested-call site (entry 8; five pushes flip to 0).",
      block: {
        // ---- prologue ------------------------------------------------------
        push r12;
        push r13;
        push r14;
        push r15;
        push rbx;

        mov r14, rsi;                   // r14 = received_ptr
        mov r15, rdx;                   // r15 = received_count

        // ==================================================================
        // Pass 1: for each declared kind name, must appear in received[].
        // ==================================================================
        xor r12, r12;                   // i = 0

      _cmv_pass1_head:
        lea r11, [rip + req_count];
        mov rax, [r11];
        cmp r12, rax;
        jge _cmv_pass2_init;

        // name = CapsDecl::req_kind_names[i]
        lea r11, [rip + req_kind_names];
        mov rdi, [r11 + r12*8];

        call kind_names_resolve;

        // Compare rax against CAP_KIND_UNKNOWN (large imm → via r11).
        mov r11, 0xFFFFFFF4;
        cmp rax, r11;
        je _cmv_unknown_kind;

        // rax = target ordinal. Save it and scan received[].
        mov rcx, rax;                   // rcx = target kind ord
        xor r13, r13;                   // j = 0

      _cmv_pass1_scan_recv:
        cmp r13, r15;
        jge _cmv_missing;

        // recv kind = (received[j].qword0 >> 16) & 0xFFFF
        mov r8, r14;
        mov rax, r13;
        shl rax, 4;                     // j * 16 (Cap record stride)
        add r8, rax;                    // &received[j]
        mov rax, [r8];                  // qword0
        shr rax, 16;
        and rax, 0xFFFF;
        cmp rax, rcx;
        je _cmv_pass1_next_decl;

        add r13, 1;
        jmp _cmv_pass1_scan_recv;

      _cmv_pass1_next_decl:
        add r12, 1;
        jmp _cmv_pass1_head;

        // ==================================================================
        // Pass 2: for each received Cap, must appear in decl (by kind).
        // ==================================================================
      _cmv_pass2_init:
        xor r12, r12;                   // i = 0 (over received[])

      _cmv_pass2_head:
        cmp r12, r15;
        jge _cmv_ok;

        // recv kind = (received[i].qword0 >> 16) & 0xFFFF
        mov r8, r14;
        mov rax, r12;
        shl rax, 4;
        add r8, rax;
        mov rax, [r8];
        shr rax, 16;
        and rax, 0xFFFF;
        mov rbx, rax;                   // rbx = current recv kind

        xor r13, r13;                   // j = 0 (over decl)

      _cmv_pass2_scan_decl:
        lea r11, [rip + req_count];
        mov rax, [r11];
        cmp r13, rax;
        jge _cmv_extra;

        lea r11, [rip + req_kind_names];
        mov rdi, [r11 + r13*8];

        call kind_names_resolve;

        // Compare returned ordinal against rbx (recv kind).
        // rbx fits in u16, so no large-imm compare — direct cmp is safe.
        cmp rax, rbx;
        je _cmv_pass2_next_recv;

        add r13, 1;
        jmp _cmv_pass2_scan_decl;

      _cmv_pass2_next_recv:
        add r12, 1;
        jmp _cmv_pass2_head;

        // ==================================================================
        // Exits
        // ==================================================================
      _cmv_ok:
        xor rax, rax;                   // CAP_OK
        jmp _cmv_epilogue;

      _cmv_missing:
        mov rax, 0xFFFFFFFC;            // CAP_MANIFEST_MISSING
        jmp _cmv_epilogue;

      _cmv_extra:
        mov rax, 0xFFFFFFFB;            // CAP_MANIFEST_EXTRA
        jmp _cmv_epilogue;

      _cmv_unknown_kind:
        mov rax, 0xFFFFFFF4;            // CAP_KIND_UNKNOWN

      _cmv_epilogue:
        pop rbx;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }
}
