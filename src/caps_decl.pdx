// src/caps_decl.pdx — libpdx-cap.M1-002
// CapsDecl module: parser for the caps.decl text file every tool ships
// at its repo root (per invariant I6 in design/tooling/plan.md).
//
// Design context
// --------------
// Every tool declares which capabilities it consumes at exec in a
// caps.decl file (see caps.decl at repo root as a canonical example).
// libpdx-cap parses that file into a machine-readable record so
// cap_manifest_verify (M2-001) can compare declared-vs-received cap
// sets. The parser is invoked ONCE per process at _start; the record
// lives in .bss (singleton pattern).
//
// Grammar (M1 subset — full spec in design/architecture.md §4):
//
//   file    = line*
//   line    = SPACES? content NL
//   content = ""                                    (empty)
//           | "#" ANYCHAR*                          (comment)
//           | "requires:"                           (start REQ section)
//           | "requires: (none)"                    (empty REQ, inline)
//           | "declares_output_schemas:"            (start SCH section)
//           | "declares_output_schemas: (none)"     (empty SCH, inline)
//           | "-" SPACES item                       (list item)
//   item    = IDENT ( "(" ANYCHAR* ")" )? ( "@" IDENT )?
//
// State machine:
//   TOP  → accepts headers only
//   REQ  → accepts list items OR the schemas header
//   SCH  → accepts list items only
//
// Storage: singleton in .bss (mirrors ParsedArgs in libpdx-argv).
//
// paideia-as compliance
// ---------------------
//   - Module name PascalCase basename (`CapsDecl`), no directory prefix.
//   - No `test` mnemonic; every zero-check uses `cmp reg, 0`.
//   - Every `cmp reg, imm` uses immediate ≤ 0x7FFFFFFF.
//   - r11 is scratch (paideia-as-reserved).
//   - Byte reads use `xor rax, rax; mov_b rax, [ptr]` (#1248 mitigation).
//   - Leaf function; SysV push/pop parity preserved (only callee-save
//     touched are r12 + r13; two pushes → return-addr-relative rsp
//     alignment neutral for a function that makes no nested calls).

module CapsDecl = structure {

  // ============================================================================
  // Return codes
  // ============================================================================

  // Success — parsed file honoured the grammar.
  pub let CAPS_DECL_OK               : u64 = 0

  // Too many requires items (> CAPS_DECL_MAX_REQ). The parser stops at
  // the offending item; req_count == CAPS_DECL_MAX_REQ at that point.
  pub let CAPS_DECL_REQ_OVERFLOW     : u64 = 0xFFFFFFFA

  // Too many schema declarations (> CAPS_DECL_MAX_SCHEMAS). Symmetric
  // to REQ_OVERFLOW.
  pub let CAPS_DECL_SCHEMA_OVERFLOW  : u64 = 0xFFFFFFF9

  // Line does not match any header form in the current state. The
  // parser stops; error_line_index names the offending line.
  pub let CAPS_DECL_MALFORMED_HEADER : u64 = 0xFFFFFFF8

  // List item does not match `IDENT (...)? (@IDENT)?` — typically an
  // empty item ("- \n") or a missing identifier ("-\n").
  pub let CAPS_DECL_MALFORMED_ITEM   : u64 = 0xFFFFFFF7

  // List item appeared in TOP state (before any section was opened).
  pub let CAPS_DECL_ITEM_OUT_OF_SECTION : u64 = 0xFFFFFFF6

  // ============================================================================
  // Storage caps
  // ============================================================================

  // Max list items per section. Fits `cmp reg, imm ≤ 0x7FFFFFFF` by wide
  // margin; the largest observed real caps.decl has 6 requires items
  // (pkg install with signed-blob + audit + elevate + pdxfs read/write
  // + tty).
  pub let CAPS_DECL_MAX_REQ     : u64 = 16
  pub let CAPS_DECL_MAX_SCHEMAS : u64 = 16

  // ============================================================================
  // State constants (parser-internal; exposed as pub for tests)
  // ============================================================================

  pub let STATE_TOP : u64 = 0
  pub let STATE_REQ : u64 = 1
  pub let STATE_SCH : u64 = 2

  // ============================================================================
  // Singleton storage (bootstrap-scope; M4 migrates to caller-owned)
  // ============================================================================

  // Requires-section records. Both arrays are indexed by k in
  // 0..req_count. Every pointer is INTERIOR into the caller's source
  // buffer; the parser NUL-terminates the identifier in place (same
  // precedent as tokenizer.pdx and parser.pdx).
  pub let mut req_kind_names : [u64; 16] = uninit @align(8)
  pub let mut req_args_texts : [u64; 16] = uninit @align(8)  // 0 if item has no "(...)"
  pub let mut req_count      : u64       = uninit @align(8)

  // Declares-schemas records.
  pub let mut schema_names   : [u64; 16] = uninit @align(8)
  pub let mut schema_count   : u64       = uninit @align(8)

  // Diagnostic slots.
  pub let mut error_code       : u64 = uninit @align(8)
  pub let mut error_line_index : u64 = uninit @align(8)

  // ============================================================================
  // caps_decl_reset()
  //
  // Clear the four counters + the two diagnostic slots. The pointer
  // arrays (`req_kind_names`, `req_args_texts`, `schema_names`) are
  // consumed by index up to their counters, so stale trailing entries
  // are unreachable and do not need zeroing.
  //
  // Leaf; r11 scratch; no push/pop parity to preserve.
  // ============================================================================
  pub let caps_decl_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-cap.M1-002 caps_decl_reset. Zero the four counters + error slots so caps_decl_parse starts from a known-empty CapsDecl. xor rax,rax; four lea+mov to the four counters + two error slots. Pointer arrays are index-consumed, so trailing entries do not need zeroing (same idiom as ParsedArgs::reset in libpdx-argv). r11 is scratch (paideia-as conformance). Leaf.",
      block: {
        xor rax, rax;
        lea r11, [rip + req_count];        mov [r11], rax;
        lea r11, [rip + schema_count];     mov [r11], rax;
        lea r11, [rip + error_code];       mov [r11], rax;
        lea r11, [rip + error_line_index]; mov [r11], rax;
        ret
      }
    }

  // ============================================================================
  // caps_decl_parse(src, src_len) -> rc
  //
  // Signature: caps_decl_parse : (u64, u64) -> u64 !{mem} @{}
  // RDI (input): src     — VA of the caps.decl text (NUL not required)
  // RSI (input): src_len — number of bytes
  // RAX (output): CAPS_DECL_OK or one of the CAPS_DECL_* error codes
  //
  // Walks src left-to-right one line at a time. Each line is classified
  // by the first non-whitespace byte + (for headers) an exact-byte
  // compare of the leading identifier. Successful list items get their
  // identifier NUL-terminated in place at the boundary byte (`(`, `@`,
  // ' ', or '\n') so downstream consumers see a C-string.
  //
  // On error the parser records `error_code` and `error_line_index`
  // (0-indexed) and returns the same code in rax; consumers can render
  // a diagnostic without a second load.
  //
  // Register plan (leaf, but uses two callee-save regs for line_index
  // + end preservation — two pushes preserve SysV parity because the
  // function makes NO nested calls):
  //   r8  = cursor (running byte pointer into src)
  //   r9  = end   (src + src_len; loaded once, never mutated)
  //   r10 = state (STATE_TOP/REQ/SCH)
  //   r11 = scratch (LEA target for every .bss store; masking scratch)
  //   r12 = line_index (0-based; incremented at end of each line)  [callee-save]
  //   r13 = walk cursor within current line  [callee-save]
  //   rax = byte load / return value scratch
  //   rcx = generic working cursor / count
  //   rdx = current-line pointer (line_start; used for item recording)
  // ============================================================================
  pub let caps_decl_parse : (u64, u64) -> u64 !{mem} @{} =
    fn (src: u64) (src_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-cap.M1-002 caps_decl_parse. Line-oriented text parser for the caps.decl grammar (design/architecture.md §4). Walks src byte-by-byte with r8 as cursor, r9 as end (loaded once). State machine (r10) transitions TOP→REQ on 'requires:', TOP→SCH or REQ→SCH on 'declares_output_schemas:', TOP→TOP on '<hdr>: (none)'. In REQ / SCH, list items ('-') append to req_kind_names / schema_names with in-place NUL-termination at the item boundary (same idiom as tokenizer.pdx and libpdx-argv parser.pdx). Overflow gated at CAPS_DECL_MAX_REQ / CAPS_DECL_MAX_SCHEMAS before every write. paideia-as conformance: xor rax,rax; mov_b before every byte compare (#1248 mitigation); every cmp reg,imm uses imm ≤ 0x7FFFFFFF; r11 reserved as .bss LEA scratch. Two callee-save regs used (r12 line_index, r13 line-walk cursor) with matched push/pop; function makes NO nested calls so alignment is irrelevant.",
      block: {
        // ---- prologue -------------------------------------------------------
        push r12;
        push r13;

        mov r8, rdi;                    // r8 = cursor = src
        mov r9, rdi;
        add r9, rsi;                    // r9 = end = src + src_len
        xor r10, r10;                   // r10 = state = STATE_TOP (0)
        xor r12, r12;                   // r12 = line_index = 0

      // ==== per-line loop head =============================================
      caps_line_head:
        cmp r8, r9;
        jge caps_parse_done_ok;

        // ---- skip leading spaces/tabs ---------------------------------------
      caps_skip_leading_ws:
        cmp r8, r9;
        jge caps_line_advance_newline_or_end;
        xor rax, rax;
        mov_b rax, [r8];
        cmp rax, 0x20;                  // ' '
        je caps_bump_leading_ws;
        cmp rax, 0x09;                  // '\t'
        je caps_bump_leading_ws;
        jmp caps_classify_first;

      caps_bump_leading_ws:
        add r8, 1;
        jmp caps_skip_leading_ws;

        // ---- classify first non-ws byte -------------------------------------
      caps_classify_first:
        // rax = first non-ws byte at r8
        cmp rax, 0x0A;                  // '\n' → empty line
        je caps_line_consume_nl;
        cmp rax, 0x23;                  // '#' → comment
        je caps_line_skip_to_nl;
        cmp rax, 0x2D;                  // '-' → list item
        je caps_try_list_item;
        cmp rax, 0x72;                  // 'r' → try "requires:"
        je caps_try_requires;
        cmp rax, 0x64;                  // 'd' → try "declares_output_schemas:"
        je caps_try_declares;
        // Any other first char → malformed header (unknown top-level form).
        mov rax, 0xFFFFFFF8;            // CAPS_DECL_MALFORMED_HEADER
        jmp caps_parse_fail;

      // ==== "requires:" ====================================================
      caps_try_requires:
        // Byte-by-byte compare of "requires:" starting at r8.
        //   r 0x72 | e 0x65 | q 0x71 | u 0x75 | i 0x69 | r 0x72 | e 0x65 | s 0x73 | : 0x3A
        // Byte0 already known == 'r' (matched to reach here). Verify [1..8].
        xor rax, rax; mov_b rax, [r8 + 1]; cmp rax, 0x65; jne caps_hdr_bad;  // e
        xor rax, rax; mov_b rax, [r8 + 2]; cmp rax, 0x71; jne caps_hdr_bad;  // q
        xor rax, rax; mov_b rax, [r8 + 3]; cmp rax, 0x75; jne caps_hdr_bad;  // u
        xor rax, rax; mov_b rax, [r8 + 4]; cmp rax, 0x69; jne caps_hdr_bad;  // i
        xor rax, rax; mov_b rax, [r8 + 5]; cmp rax, 0x72; jne caps_hdr_bad;  // r
        xor rax, rax; mov_b rax, [r8 + 6]; cmp rax, 0x65; jne caps_hdr_bad;  // e
        xor rax, rax; mov_b rax, [r8 + 7]; cmp rax, 0x73; jne caps_hdr_bad;  // s
        xor rax, rax; mov_b rax, [r8 + 8]; cmp rax, 0x3A; jne caps_hdr_bad;  // ':'

        // Advance past "requires:" (9 bytes).
        add r8, 9;

        // Look for optional " (none)" tail (or newline).
        mov r13, r8;                    // r13 = probe cursor
      caps_req_check_none:
        cmp r13, r9;
        jge caps_req_open_section;      // EOF right after "requires:" → open section
        xor rax, rax;
        mov_b rax, [r13];
        cmp rax, 0x0A;                  // '\n' → open section
        je caps_req_open_section;
        cmp rax, 0x20;                  // ' ' → keep scanning
        je caps_req_bump_none;
        cmp rax, 0x28;                  // '(' → begin "(none)" check
        je caps_req_try_none;
        // Any other char between "requires:" and NL is malformed.
        mov rax, 0xFFFFFFF8;            // CAPS_DECL_MALFORMED_HEADER
        jmp caps_parse_fail;

      caps_req_bump_none:
        add r13, 1;
        jmp caps_req_check_none;

      caps_req_try_none:
        // r13 == '('. Verify "(none)".
        xor rax, rax; mov_b rax, [r13 + 1]; cmp rax, 0x6E; jne caps_hdr_bad;  // n
        xor rax, rax; mov_b rax, [r13 + 2]; cmp rax, 0x6F; jne caps_hdr_bad;  // o
        xor rax, rax; mov_b rax, [r13 + 3]; cmp rax, 0x6E; jne caps_hdr_bad;  // n
        xor rax, rax; mov_b rax, [r13 + 4]; cmp rax, 0x65; jne caps_hdr_bad;  // e
        xor rax, rax; mov_b rax, [r13 + 5]; cmp rax, 0x29; jne caps_hdr_bad;  // ')'
        // "(none)" matched — section is empty; stay in TOP state.
        xor r10, r10;                   // state = STATE_TOP
        add r13, 6;
        mov r8, r13;
        jmp caps_line_skip_to_nl;       // consume rest of line + NL

      caps_req_open_section:
        // Open REQ section. r10 = STATE_REQ.
        mov r10, 1;                     // STATE_REQ
        mov r8, r13;
        jmp caps_line_skip_to_nl;

      // ==== "declares_output_schemas:" =====================================
      caps_try_declares:
        // Byte-by-byte compare of "declares_output_schemas:" (24 bytes).
        // Byte0 already known == 'd'. Verify [1..23].
        xor rax, rax; mov_b rax, [r8 +  1]; cmp rax, 0x65; jne caps_hdr_bad;  // e
        xor rax, rax; mov_b rax, [r8 +  2]; cmp rax, 0x63; jne caps_hdr_bad;  // c
        xor rax, rax; mov_b rax, [r8 +  3]; cmp rax, 0x6C; jne caps_hdr_bad;  // l
        xor rax, rax; mov_b rax, [r8 +  4]; cmp rax, 0x61; jne caps_hdr_bad;  // a
        xor rax, rax; mov_b rax, [r8 +  5]; cmp rax, 0x72; jne caps_hdr_bad;  // r
        xor rax, rax; mov_b rax, [r8 +  6]; cmp rax, 0x65; jne caps_hdr_bad;  // e
        xor rax, rax; mov_b rax, [r8 +  7]; cmp rax, 0x73; jne caps_hdr_bad;  // s
        xor rax, rax; mov_b rax, [r8 +  8]; cmp rax, 0x5F; jne caps_hdr_bad;  // _
        xor rax, rax; mov_b rax, [r8 +  9]; cmp rax, 0x6F; jne caps_hdr_bad;  // o
        xor rax, rax; mov_b rax, [r8 + 10]; cmp rax, 0x75; jne caps_hdr_bad;  // u
        xor rax, rax; mov_b rax, [r8 + 11]; cmp rax, 0x74; jne caps_hdr_bad;  // t
        xor rax, rax; mov_b rax, [r8 + 12]; cmp rax, 0x70; jne caps_hdr_bad;  // p
        xor rax, rax; mov_b rax, [r8 + 13]; cmp rax, 0x75; jne caps_hdr_bad;  // u
        xor rax, rax; mov_b rax, [r8 + 14]; cmp rax, 0x74; jne caps_hdr_bad;  // t
        xor rax, rax; mov_b rax, [r8 + 15]; cmp rax, 0x5F; jne caps_hdr_bad;  // _
        xor rax, rax; mov_b rax, [r8 + 16]; cmp rax, 0x73; jne caps_hdr_bad;  // s
        xor rax, rax; mov_b rax, [r8 + 17]; cmp rax, 0x63; jne caps_hdr_bad;  // c
        xor rax, rax; mov_b rax, [r8 + 18]; cmp rax, 0x68; jne caps_hdr_bad;  // h
        xor rax, rax; mov_b rax, [r8 + 19]; cmp rax, 0x65; jne caps_hdr_bad;  // e
        xor rax, rax; mov_b rax, [r8 + 20]; cmp rax, 0x6D; jne caps_hdr_bad;  // m
        xor rax, rax; mov_b rax, [r8 + 21]; cmp rax, 0x61; jne caps_hdr_bad;  // a
        xor rax, rax; mov_b rax, [r8 + 22]; cmp rax, 0x73; jne caps_hdr_bad;  // s
        xor rax, rax; mov_b rax, [r8 + 23]; cmp rax, 0x3A; jne caps_hdr_bad;  // ':'

        // Advance past "declares_output_schemas:" (24 bytes).
        add r8, 24;

        // Look for optional " (none)" tail (or newline).
        mov r13, r8;
      caps_sch_check_none:
        cmp r13, r9;
        jge caps_sch_open_section;
        xor rax, rax;
        mov_b rax, [r13];
        cmp rax, 0x0A;
        je caps_sch_open_section;
        cmp rax, 0x20;
        je caps_sch_bump_none;
        cmp rax, 0x28;
        je caps_sch_try_none;
        mov rax, 0xFFFFFFF8;            // CAPS_DECL_MALFORMED_HEADER
        jmp caps_parse_fail;

      caps_sch_bump_none:
        add r13, 1;
        jmp caps_sch_check_none;

      caps_sch_try_none:
        xor rax, rax; mov_b rax, [r13 + 1]; cmp rax, 0x6E; jne caps_hdr_bad;  // n
        xor rax, rax; mov_b rax, [r13 + 2]; cmp rax, 0x6F; jne caps_hdr_bad;  // o
        xor rax, rax; mov_b rax, [r13 + 3]; cmp rax, 0x6E; jne caps_hdr_bad;  // n
        xor rax, rax; mov_b rax, [r13 + 4]; cmp rax, 0x65; jne caps_hdr_bad;  // e
        xor rax, rax; mov_b rax, [r13 + 5]; cmp rax, 0x29; jne caps_hdr_bad;  // ')'
        // "(none)" matched — stay in TOP (schemas section empty).
        xor r10, r10;                   // state = STATE_TOP
        add r13, 6;
        mov r8, r13;
        jmp caps_line_skip_to_nl;

      caps_sch_open_section:
        mov r10, 2;                     // STATE_SCH
        mov r8, r13;
        jmp caps_line_skip_to_nl;

      caps_hdr_bad:
        mov rax, 0xFFFFFFF8;            // CAPS_DECL_MALFORMED_HEADER
        jmp caps_parse_fail;

      // ==== "- IDENT..." list item =========================================
      caps_try_list_item:
        // r8 → '-'. Reject if not in REQ or SCH state.
        cmp r10, 0;
        je caps_item_out_of_section;

        // Skip the '-' and any leading spaces/tabs before the identifier.
        add r8, 1;
      caps_item_skip_lead_ws:
        cmp r8, r9;
        jge caps_item_bad;
        xor rax, rax;
        mov_b rax, [r8];
        cmp rax, 0x20;
        je caps_item_bump_ws;
        cmp rax, 0x09;
        je caps_item_bump_ws;
        cmp rax, 0x0A;                  // "-\n" or "-  \n" → bad item
        je caps_item_bad;
        jmp caps_item_ident_start;
      caps_item_bump_ws:
        add r8, 1;
        jmp caps_item_skip_lead_ws;

      caps_item_ident_start:
        // rdx = identifier start pointer. Walk to first boundary byte:
        //   '(' 0x28 | '@' 0x40 | ' ' 0x20 | '\t' 0x09 | '\n' 0x0A | EOF
        mov rdx, r8;                    // rdx = ident start
        mov r13, r8;                    // r13 = walk cursor

      caps_item_walk_ident:
        cmp r13, r9;
        jge caps_item_ident_done_eof;
        xor rax, rax;
        mov_b rax, [r13];
        cmp rax, 0x28;                  // '('
        je caps_item_ident_done_paren;
        cmp rax, 0x40;                  // '@'
        je caps_item_ident_done_at;
        cmp rax, 0x20;
        je caps_item_ident_done_ws;
        cmp rax, 0x09;
        je caps_item_ident_done_ws;
        cmp rax, 0x0A;
        je caps_item_ident_done_nl;
        add r13, 1;
        jmp caps_item_walk_ident;

      // ---- Four boundary-byte terminations: NUL-terminate + branch --------
      caps_item_ident_done_paren:
        // args-text begins at r13 (points to '('). NUL the '('. Record
        // args ptr = original r13 (before overwrite; kept in rax post-op).
        mov rcx, r13;                   // rcx = ptr to '(' for args record
        xor rax, rax;
        mov_b [r13], rax;               // NUL-terminate identifier
        // Store item with args_text = rcx.
        jmp caps_item_record;

      caps_item_ident_done_at:
      caps_item_ident_done_ws:
      caps_item_ident_done_nl:
        // Ident boundary. No args-text. Zero rcx before NUL so the store
        // path sees args_text = 0.
        xor rcx, rcx;
        xor rax, rax;
        mov_b [r13], rax;               // NUL-terminate identifier
        jmp caps_item_record;

      caps_item_ident_done_eof:
        // Ident ran off the end. No trailing byte to NUL — the src
        // buffer's caller-owned invariant guarantees the byte past r9
        // is not our concern. Record args_text = 0.
        xor rcx, rcx;
        jmp caps_item_record;

      // ---- Item record ----------------------------------------------------
      caps_item_record:
        // rdx = ident ptr. rcx = args ptr (or 0). r10 = state.
        // Dispatch by state.
        cmp r10, 1;                     // STATE_REQ
        je caps_item_record_req;
        cmp r10, 2;                     // STATE_SCH
        je caps_item_record_sch;
        // Unreachable: item_out_of_section already caught STATE_TOP.
        mov rax, 0xFFFFFFF6;            // CAPS_DECL_ITEM_OUT_OF_SECTION
        jmp caps_parse_fail;

      caps_item_record_req:
        lea r11, [rip + req_count];
        mov rax, [r11];
        cmp rax, 16;                    // CAPS_DECL_MAX_REQ
        jge caps_req_overflow;

        lea r11, [rip + req_kind_names];
        mov [r11 + rax*8], rdx;

        lea r11, [rip + req_args_texts];
        mov [r11 + rax*8], rcx;

        add rax, 1;
        lea r11, [rip + req_count];
        mov [r11], rax;

        // Advance past whatever remained on the line.
        mov r8, r13;
        jmp caps_line_skip_to_nl;

      caps_item_record_sch:
        lea r11, [rip + schema_count];
        mov rax, [r11];
        cmp rax, 16;                    // CAPS_DECL_MAX_SCHEMAS
        jge caps_sch_overflow;

        lea r11, [rip + schema_names];
        mov [r11 + rax*8], rdx;

        add rax, 1;
        lea r11, [rip + schema_count];
        mov [r11], rax;

        mov r8, r13;
        jmp caps_line_skip_to_nl;

      caps_item_bad:
        mov rax, 0xFFFFFFF7;            // CAPS_DECL_MALFORMED_ITEM
        jmp caps_parse_fail;

      caps_item_out_of_section:
        mov rax, 0xFFFFFFF6;            // CAPS_DECL_ITEM_OUT_OF_SECTION
        jmp caps_parse_fail;

      caps_req_overflow:
        mov rax, 0xFFFFFFFA;            // CAPS_DECL_REQ_OVERFLOW
        jmp caps_parse_fail;

      caps_sch_overflow:
        mov rax, 0xFFFFFFF9;            // CAPS_DECL_SCHEMA_OVERFLOW
        jmp caps_parse_fail;

      // ==== per-line trailer helpers =======================================
      caps_line_skip_to_nl:
        // Consume bytes until '\n' or EOF, then bump cursor past the NL.
        cmp r8, r9;
        jge caps_line_at_eof;
        xor rax, rax;
        mov_b rax, [r8];
        cmp rax, 0x0A;
        je caps_line_consume_nl;
        add r8, 1;
        jmp caps_line_skip_to_nl;

      caps_line_consume_nl:
        add r8, 1;                      // step past '\n'
        add r12, 1;                     // line_index++
        jmp caps_line_head;

      caps_line_at_eof:
        // No trailing NL — treat as end of file after this line.
        add r12, 1;
        jmp caps_parse_done_ok;

      caps_line_advance_newline_or_end:
        // Whitespace-only line — no content byte was found before EOF.
        // Effectively a blank line at file end.
        jmp caps_parse_done_ok;

      // ==== exits ==========================================================
      caps_parse_done_ok:
        xor rax, rax;                   // CAPS_DECL_OK
        lea r11, [rip + error_code];
        mov [r11], rax;
        jmp caps_parse_epilogue;

      caps_parse_fail:
        // rax = error code (already loaded by fail arm). Record it +
        // line_index so the consumer's stderr diagnostic can point at
        // the offending line.
        lea r11, [rip + error_code];
        mov [r11], rax;
        lea r11, [rip + error_line_index];
        mov [r11], r12;
        // Fall through to epilogue with rax preserved.

      caps_parse_epilogue:
        pop r13;
        pop r12;
        ret
      }
    }

  // ============================================================================
  // M3-001 — rights-args-text refinement helpers
  //
  // At M1-002 the parser stored the pointer to the '(' byte of every
  // list-item args-text in `req_args_texts[k]`, but never inspected
  // the interior. M2 compared caps by KIND ordinal alone; the
  // (read, subtree=/home) suffix was untouched. M3-001 lifts the
  // interior into a query API so cp/mv/rm can compare the received
  // rights-args against the callee's declared refinements without
  // each consumer re-implementing the tokenizer.
  //
  // Grammar of the args-text (subset covering R49-wave consumers):
  //
  //   args-text = '(' token ( ',' SPACES? token )* ')'
  //   token     = bare-ident              // e.g. "read", "write"
  //             | key '=' value           // e.g. "subtree=/home"
  //   key       = IDENT
  //   value     = VCHAR*                  // stops at ',', ')', ws, or EOF
  //
  // The two entry points below are the only surface a consumer needs:
  //
  //   caps_decl_args_has(args_ptr, needle_ptr) -> 0 | 1
  //     Bare-token membership. Returns 1 iff `needle` appears as a
  //     comma-separated token inside `args_ptr`'s parentheses.
  //     Whitespace inside the parentheses is skipped. Matching is
  //     byte-exact and case-sensitive. `needle` matches a bare ident
  //     OR the key half of a key=value (so `caps_decl_args_has(a, "subtree")`
  //     returns 1 for both `(subtree=/home)` and `(read, subtree=/home)`).
  //
  //   caps_decl_args_get(args_ptr, key_ptr) -> 0 | 1
  //     Key=value lookup. Returns 1 iff `key=value` is a token; on hit
  //     populates the singleton slots `caps_decl_args_value_ptr` (VA of
  //     the first byte after '=' inside the args buffer) and
  //     `caps_decl_args_value_len` (byte length of the value until
  //     the next ',', ')', ws, or EOF). Bare tokens (no '=') do NOT
  //     hit `get`; they hit only `has`.
  //
  // Both entry points return 0 immediately if `args_ptr == 0` (the
  // parser encodes "no args-text" as a null pointer in
  // `req_args_texts[k]`), so a caller can dispatch through them
  // uniformly without a defensive null check.
  //
  // The two entries share a single walker shape: for each token,
  // compare byte-by-byte against the needle/key, then dispatch on
  // the boundary byte (`,`, `)`, ws, `=`, EOF) to decide match /
  // no-match / skip-to-next-token. Both are leaf functions and use
  // three callee-save pushes (r12, r13, r14) for the args cursor,
  // needle cursor save, and per-token walk cursor. No nested calls
  // → alignment at call site is not an obligation; only push/pop
  // parity matters.
  //
  // paideia-as compliance: byte reads via `xor rax, rax; mov_b rax, [ptr]`;
  // every `cmp reg, imm` uses tiny immediates (single-byte ASCII); no
  // `test` mnemonic; r11 reserved as .bss LEA scratch for
  // singleton stores.
  // ============================================================================

  // Value-lookup singleton (populated on caps_decl_args_get success).
  // Interior pointer into the args-text buffer; length excludes the
  // terminator. `caps_decl_args_get` MUST NOT NUL-terminate the value
  // in place — a subsequent get for a different key would then walk
  // past the injected NUL and read stale bytes. Consumers copy the
  // value into their own buffer using the (ptr, len) pair.
  pub let mut caps_decl_args_value_ptr : u64 = uninit @align(8)
  pub let mut caps_decl_args_value_len : u64 = uninit @align(8)

  // ============================================================================
  // caps_decl_args_has(args_ptr, needle_ptr) -> u64
  //
  // Signature: caps_decl_args_has : (u64, u64) -> u64 !{mem} @{}
  // RDI (input): args_ptr   — VA of the '(' byte from
  //                            CapsDecl::req_args_texts[k], or 0 if
  //                            the item had no args-text.
  // RSI (input): needle_ptr — VA of a NUL-terminated ASCII token to
  //                            search for.
  // RAX (output): 1 if `needle` appears as a bare token or as the
  //                key half of a key=value inside the parentheses,
  //                0 otherwise. Also 0 if args_ptr == 0.
  //
  // Register plan (leaf, no nested calls):
  //   r12 = args cursor (advances through the args-text)  [callee-save]
  //   r13 = needle base (reloaded into r14 at each new token) [callee-save]
  //   r14 = per-token needle walk cursor                  [callee-save]
  //   rax = args byte load
  //   rcx = needle byte load
  //   r11 = unused (no .bss stores in this entry)
  //
  // rsp alignment: 3 callee-save pushes; no nested calls, so alignment
  // at call sites is not a concern. Push/pop parity is preserved on
  // every exit.
  // ============================================================================
  pub let caps_decl_args_has : (u64, u64) -> u64 !{mem} @{} =
    fn (args_ptr: u64) (needle_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-cap.M3-001 caps_decl_args_has. Walks the args-text at args_ptr looking for a comma-separated token matching needle. If args_ptr == 0 (no args-text on the caps.decl item) returns 0 immediately without touching callee-save regs. Otherwise skips the '(' at offset 0, then for each token: skips leading whitespace, walks needle-vs-args byte-by-byte using #1248-safe reads, and on needle-end verifies the args byte is a token boundary (',', ')', ws, '=', or NUL). Match on boundary returns 1; mismatch or non-boundary skips to the next ',' and retries. r12 holds args cursor across the outer loop; r13 preserves needle base for reloads at each new token; r14 is the per-token needle walk cursor. Three callee-save pushes with matched pops on all three exit paths (has=yes, has=no with pop, has=no fast without pop). paideia-as conformance: every cmp reg,imm uses single-byte ASCII imms; #1248-safe byte reads; r11 unused (no .bss touch); no `test` mnemonic. Leaf function; no nested calls.",
      block: {
        // Fast path: no args-text → cannot possibly contain the needle.
        cmp rdi, 0;
        je _cah_no_fast;

        // ---- prologue ----
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                   // r12 = args cursor
        add r12, 1;                     // skip '('
        mov r13, rsi;                   // r13 = needle base

      _cah_token_head:
        // Skip leading whitespace inside this token.
      _cah_skip_ws:
        xor rax, rax;
        mov_b rax, [r12];
        cmp rax, 0x20;                  // ' '
        je _cah_bump_ws;
        cmp rax, 0x09;                  // '\t'
        je _cah_bump_ws;
        jmp _cah_compare_setup;

      _cah_bump_ws:
        add r12, 1;
        jmp _cah_skip_ws;

      _cah_compare_setup:
        // Start byte-by-byte compare. r14 = needle walk cursor.
        mov r14, r13;

      _cah_compare:
        xor rax, rax;
        mov_b rax, [r12];               // args byte
        xor rcx, rcx;
        mov_b rcx, [r14];               // needle byte
        cmp rcx, 0;
        je _cah_needle_end;             // needle exhausted; check boundary
        cmp rax, rcx;
        jne _cah_skip_token;
        add r12, 1;
        add r14, 1;
        jmp _cah_compare;

      _cah_needle_end:
        // Needle matched; args byte in rax must be a token boundary
        // for a real hit. Otherwise needle is a prefix of a longer
        // token and the compare fails.
        cmp rax, 0x29;                  // ')'
        je _cah_yes;
        cmp rax, 0x2C;                  // ','
        je _cah_yes;
        cmp rax, 0x20;
        je _cah_yes;
        cmp rax, 0x09;
        je _cah_yes;
        cmp rax, 0x3D;                  // '='
        je _cah_yes;
        cmp rax, 0;                     // EOF sentinel
        je _cah_yes;
        // Prefix match, not a whole-token hit — skip.
        jmp _cah_skip_token;

      _cah_skip_token:
        // Advance to the next ',' or ')' (or EOF), then either wrap
        // to the next token or terminate.
        xor rax, rax;
        mov_b rax, [r12];
        cmp rax, 0x2C;                  // ','
        je _cah_after_comma;
        cmp rax, 0x29;                  // ')'
        je _cah_no_pop;
        cmp rax, 0;                     // EOF
        je _cah_no_pop;
        add r12, 1;
        jmp _cah_skip_token;

      _cah_after_comma:
        add r12, 1;                     // step past ','
        jmp _cah_token_head;

      _cah_yes:
        mov rax, 1;
        pop r14;
        pop r13;
        pop r12;
        ret;

      _cah_no_pop:
        xor rax, rax;
        pop r14;
        pop r13;
        pop r12;
        ret;

      _cah_no_fast:
        xor rax, rax;
        ret
      }
    }

  // ============================================================================
  // caps_decl_args_get(args_ptr, key_ptr) -> u64
  //
  // Signature: caps_decl_args_get : (u64, u64) -> u64 !{mem} @{}
  // RDI (input): args_ptr — VA of the '(' byte (or 0 for no args).
  // RSI (input): key_ptr  — VA of a NUL-terminated ASCII key name.
  // RAX (output): 1 on hit, 0 on miss. On hit the singleton slots
  //                `caps_decl_args_value_ptr` and `_len` are populated;
  //                on miss they are UNTOUCHED (fail-fast, matching
  //                cap_unpack_checked's discipline).
  //
  // Semantics: same walker as caps_decl_args_has, but the boundary
  // dispatch on needle-end requires the args byte to be exactly '='
  // (a bare token has no value and does not hit `get`). On '=' the
  // walker records the value's start pointer, walks until the value
  // terminator (',', ')', ws, EOF), records the length, then returns 1.
  //
  // Register plan (leaf, no nested calls):
  //   r12 = args cursor                                   [callee-save]
  //   r13 = key base                                      [callee-save]
  //   r14 = per-token key walk cursor / value start ptr   [callee-save]
  //   r15 = value length accumulator                      [callee-save]
  //   rax = args byte load
  //   rcx = key byte load
  //   r11 = LEA scratch for the two singleton stores (on hit only)
  //
  // Four callee-save pushes, matched pops on all exits. No nested
  // calls, so alignment at call site is not an obligation.
  // ============================================================================
  pub let caps_decl_args_get : (u64, u64) -> u64 !{mem} @{} =
    fn (args_ptr: u64) (key_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-cap.M3-001 caps_decl_args_get. Walks the args-text at args_ptr looking for a `key=value` token where key matches key_ptr. If args_ptr == 0 returns 0 immediately without touching callee-save regs or the singleton. Otherwise mirrors caps_decl_args_has's walker until needle-end, at which point the args byte MUST be '=' (a bare-token match here is a miss, not a hit — bare tokens use caps_decl_args_has). On '=' the walker steps past it, records r14 = value_ptr and r15 = value_len accumulator, walks byte-by-byte until the value terminator (',', ')', ws, EOF), then stores (value_ptr, value_len) to the singleton via r11 LEA scratch and returns 1. Miss (any non-hit exit) leaves the singleton UNTOUCHED — same fail-fast discipline as cap_unpack_checked's CAP_MANIFEST_EXTRA path. Four callee-save pushes with matched pops. paideia-as conformance: byte reads via xor rax,rax; mov_b rax,[ptr]; every cmp reg,imm uses single-byte ASCII imms; r11 scratch for singleton stores; no `test` mnemonic. Leaf function; no nested calls.",
      block: {
        // Fast path: no args-text → miss.
        cmp rdi, 0;
        je _cag_no_fast;

        // ---- prologue ----
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                   // r12 = args cursor
        add r12, 1;                     // skip '('
        mov r13, rsi;                   // r13 = key base

      _cag_token_head:
      _cag_skip_ws:
        xor rax, rax;
        mov_b rax, [r12];
        cmp rax, 0x20;
        je _cag_bump_ws;
        cmp rax, 0x09;
        je _cag_bump_ws;
        jmp _cag_compare_setup;

      _cag_bump_ws:
        add r12, 1;
        jmp _cag_skip_ws;

      _cag_compare_setup:
        mov r14, r13;                   // r14 = per-token key walk cursor

      _cag_compare:
        xor rax, rax;
        mov_b rax, [r12];               // args byte
        xor rcx, rcx;
        mov_b rcx, [r14];               // key byte
        cmp rcx, 0;
        je _cag_key_end;
        cmp rax, rcx;
        jne _cag_skip_token;
        add r12, 1;
        add r14, 1;
        jmp _cag_compare;

      _cag_key_end:
        // Key matched; args byte MUST be '=' for a value-lookup hit.
        cmp rax, 0x3D;                  // '='
        jne _cag_skip_token;
        add r12, 1;                     // step past '='
        mov r14, r12;                   // r14 = value_ptr
        xor r15, r15;                   // r15 = value_len = 0

      _cag_walk_value:
        xor rax, rax;
        mov_b rax, [r12];
        cmp rax, 0x2C;                  // ','
        je _cag_value_end;
        cmp rax, 0x29;                  // ')'
        je _cag_value_end;
        cmp rax, 0x20;                  // ' '
        je _cag_value_end;
        cmp rax, 0x09;                  // '\t'
        je _cag_value_end;
        cmp rax, 0;                     // EOF
        je _cag_value_end;
        add r12, 1;
        add r15, 1;
        jmp _cag_walk_value;

      _cag_value_end:
        // Populate singleton (value_ptr in r14, value_len in r15).
        lea r11, [rip + caps_decl_args_value_ptr];
        mov [r11], r14;
        lea r11, [rip + caps_decl_args_value_len];
        mov [r11], r15;

        mov rax, 1;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;

      _cag_skip_token:
        xor rax, rax;
        mov_b rax, [r12];
        cmp rax, 0x2C;
        je _cag_after_comma;
        cmp rax, 0x29;
        je _cag_no_pop;
        cmp rax, 0;
        je _cag_no_pop;
        add r12, 1;
        jmp _cag_skip_token;

      _cag_after_comma:
        add r12, 1;
        jmp _cag_token_head;

      _cag_no_pop:
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;

      _cag_no_fast:
        xor rax, rax;
        ret
      }
    }
}
